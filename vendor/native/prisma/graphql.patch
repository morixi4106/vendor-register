diff --git a/src/oja_security_contracts.rs b/src/oja_security_contracts.rs
new file mode 100644
index 0000000..6174745
--- /dev/null
+++ b/src/oja_security_contracts.rs
@@ -0,0 +1,54 @@
+use crate::{parse_query, parse_schema};
+
+fn nested(depth: usize) -> String {
+    format!("{}id{}", "{a ".repeat(depth), "}".repeat(depth))
+}
+fn rejected(query: &str) {
+    let error = parse_query::<String>(query).unwrap_err().to_string();
+    assert!(error.contains("Recursion limit exceeded"), "{}", error);
+}
+
+#[test] fn simple_query() { assert!(parse_query::<String>("{a}").is_ok()); }
+#[test] fn named_mutation() { assert!(parse_query::<String>("mutation M {a(value: 1)}").is_ok()); }
+#[test] fn selection_5000() { rejected(&nested(5000)); }
+#[test] fn inline_fragments() { rejected(&format!("{}a{}", "{... on Q ".repeat(5000), "}".repeat(5000))); }
+#[test] fn list_values() { rejected(&format!("{{a(value: {}1{})}}", "[".repeat(5000), "]".repeat(5000))); }
+#[test] fn object_values() { rejected(&format!("{{a(value: {}1{})}}", "{v:".repeat(5000), "}".repeat(5000))); }
+#[test] fn variable_types() { rejected(&format!("query Q($v:{}Int{}){{a}}", "[".repeat(5000), "]".repeat(5000))); }
+#[test] fn schema_types() {
+    let schema = format!("type Q{{a:{}Int{}}}", "[".repeat(5000), "]".repeat(5000));
+    assert!(parse_schema::<String>(&schema).unwrap_err().to_string().contains("Recursion limit exceeded"));
+}
+#[test] fn exact_limit() { assert!(parse_query::<String>(&nested(50)).is_ok()); }
+#[test] fn above_limit() { rejected(&nested(51)); }
+#[test] fn wide_not_deep() {
+    assert!(parse_query::<String>(&format!("{{{}}}", "a ".repeat(1000))).is_ok());
+}
+#[test] fn quoted_delimiters() {
+    assert!(parse_query::<String>(&format!("{{a(value:\"{}\")}}", "{}[]()".repeat(1000))).is_ok());
+}
+#[test] fn block_string_delimiters() {
+    assert!(parse_query::<String>(&format!("{{a(value:\"\"\"{}\"\"\")}}", "{}[]()\n".repeat(1000))).is_ok());
+}
+#[test] fn escaped_quotes() {
+    assert!(parse_query::<String>(r#"{a(value:"\"{{[]}}\"" )}"#).is_ok());
+}
+#[test] fn comments_and_bom() {
+    assert!(parse_query::<String>(&format!("\u{feff}# {}\n{{a}}", "[({".repeat(1000))).is_ok());
+}
+#[test] fn malformed_is_error() {
+    for query in &["{a(]}", "{a", "}{{", "{a(value:\"unterminated)}"] {
+        assert!(parse_query::<String>(query).is_err());
+    }
+}
+#[test] fn failure_does_not_poison_next_parse() {
+    for _ in 0..20 { rejected(&nested(51)); assert!(parse_query::<String>("{a}").is_ok()); }
+}
+#[test] fn deterministic_depth_corpus() {
+    for depth in 1..=100 {
+        let query = nested(depth);
+        assert_eq!(parse_query::<String>(&query).is_ok(), depth <= 50);
+        let schema = format!("type Q{{a:{}Int{}}}", "[".repeat(depth), "]".repeat(depth));
+        assert_eq!(parse_schema::<String>(&schema).is_ok(), depth < 50);
+    }
+}
