 impl<'a> TokenStream<'a> {
+    pub fn check_recursion_limit(s: &'a str) -> Result<(), Errors<Token<'a>, Token<'a>, Pos>> {
+        // Scan with the original lexer before any recursive grammar or AST allocation.
+        // The upstream parser uses the same limit (graphql-rust/graphql-parser d19155f).
+        let mut tokens = TokenStream::new(s);
+        let mut nesting: usize = 0;
+        while tokens.off < tokens.buf.len() {
+            let position = tokens.position;
+            let token = tokens.uncons().map_err(|e| Errors::new(position, e))?;
+            if token.kind != Kind::Punctuator { continue; }
+            match token.value {
+                "(" | "[" | "{" => {
+                    if nesting == 50 {
+                        return Err(Errors::new(position, Error::message_static_message("Recursion limit exceeded")));
+                    }
+                    nesting += 1;
+                }
+                ")" | "]" | "}" => {
+                    // Leave invalid pair diagnostics to the original grammar, like upstream.
+                    nesting = nesting.saturating_sub(1);
+                }
+                _ => {}
+            }
+        }
+        Ok(())
+    }
