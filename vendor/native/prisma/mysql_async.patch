@@ -0,0 +1,31 @@
+use crate::{conn::stmt_cache::StmtCache, queryable::stmt::StmtInner};
+use std::sync::Arc;
+
+// No connection is constructed: only real statement packet parsing and cache methods run.
+pub struct StatementCache(StmtCache);
+
+impl StatementCache {
+    pub fn new(capacity: usize) -> Self {
+        Self(StmtCache::new(capacity))
+    }
+
+    pub fn put(&mut self, id: u32, query: &[u8]) -> Option<u32> {
+        let mut packet = [0_u8; 12];
+        packet[1..5].copy_from_slice(&id.to_le_bytes());
+        let query: Arc<[u8]> = Arc::from(query);
+        let stmt = Arc::new(StmtInner::from_payload(&packet, 1, query.clone()).unwrap());
+        self.0.put(query, stmt).map(|stmt| stmt.id())
+    }
+
+    pub fn get(&mut self, query: &[u8]) -> Option<u32> {
+        self.0.by_query(query).map(|entry| entry.stmt.id())
+    }
+
+    pub fn remove(&mut self, id: u32) {
+        self.0.remove(id);
+    }
+
+    pub fn clear(&mut self) {
+        self.0.clear();
+    }
+}
