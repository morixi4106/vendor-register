+#[test]
+fn v1_small_multithreaded_batch_has_no_duplicates() {
+    let handles: Vec<_> = (0..8).map(|_| std::thread::spawn(|| (0..128).map(|_| cuid::cuid1()).collect::<Vec<_>>())).collect();
+    let ids: Vec<_> = handles.into_iter().flat_map(|handle| handle.join().unwrap()).collect();
+    for id in &ids { assert_v1(id); }
+    assert_eq!(ids.into_iter().collect::<HashSet<_>>().len(),1024);
+}
