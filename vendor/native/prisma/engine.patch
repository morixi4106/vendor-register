+use super::*;
+use super::oja_http_client_contracts::fixture;
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+async fn bytes(response: Response<ResponseBody>) -> Bytes {
+    response.into_body().collect().await.unwrap().to_bytes()
+}
+
+#[tokio::test]
+async fn json_response_preserves_status_headers_and_byte_length() {
+    let value = json!({"value": "\u{65e5}\u{672c}\u{8a9e}"});
+    let expected = serde_json::to_vec(&value).unwrap();
+    let response = build_json_response(StatusCode::CREATED, &value);
+    assert_eq!(response.status(), StatusCode::CREATED);
+    assert_eq!(response.headers()[CONTENT_TYPE], "application/json");
+    assert_eq!(response.headers()["qe-content-length"].to_str().unwrap(), expected.len().to_string());
+    assert_eq!(bytes(response).await.as_ref(), expected);
+}
+
+#[tokio::test]
+async fn empty_transaction_response_is_still_json_object() {
+    let response = empty_json_to_http_resp(None);
+    assert_eq!(response.status(), StatusCode::OK);
+    assert_eq!(response.headers()["qe-content-length"], "2");
+    assert_eq!(bytes(response).await.as_ref(), b"{}");
+}
+
+#[tokio::test]
+async fn transaction_and_timeout_error_statuses_are_preserved() {
+    use query_core::{CoreError, TransactionError};
+    let cases = [
+        (CoreError::TransactionError(TransactionError::AcquisitionTimeout), StatusCode::GATEWAY_TIMEOUT),
+        (CoreError::TransactionError(TransactionError::NotFound), StatusCode::NOT_FOUND),
+        (CoreError::TransactionError(TransactionError::Closed { reason: "closed".into() }), StatusCode::UNPROCESSABLE_ENTITY),
+        (CoreError::TransactionError(TransactionError::Unknown { reason: "unknown".into() }), StatusCode::INTERNAL_SERVER_ERROR),
+        (CoreError::QueryTimeout, StatusCode::REQUEST_TIMEOUT),
+    ];
+    for (error, status) in cases {
+        let response = err_to_http_resp(error, None);
+        assert_eq!(response.status(), status);
+        assert_eq!(response.headers()[CONTENT_TYPE], "application/json");
+        let value: serde_json::Value = serde_json::from_slice(&bytes(response).await).unwrap();
+        assert_eq!(value["is_panic"], false);
+    }
+}
+
+#[tokio::test]
+async fn debug_without_headers_returns_empty_success() {
+    let request = Request::new(ResponseBody::default());
+    let response = handle_debug_headers(&request);
+    assert_eq!(response.status(), StatusCode::OK);
+    assert!(bytes(response).await.is_empty());
+}
+
+#[tokio::test]
+async fn nonfatal_debug_header_preserves_the_panic_envelope() {
+    let request = Request::builder().header("x-debug-non-fatal", "1").body(ResponseBody::default()).unwrap();
+    let response = handle_debug_headers(&request);
+    assert_eq!(response.status(), StatusCode::OK);
+    let value: serde_json::Value = serde_json::from_slice(&bytes(response).await).unwrap();
+    assert_eq!(value["is_panic"], true);
+    assert_eq!(value["message"], "Debug panic");
+}
+
+#[tokio::test]
+async fn playground_response_retains_the_exact_html_bytes() {
+    let response = playground_handler();
+    assert_eq!(response.status(), StatusCode::OK);
+    assert_eq!(response.headers()[CONTENT_TYPE], "text/html");
+    assert_eq!(bytes(response).await.as_ref(), include_bytes!("../../static_files/playground.html"));
+}
+
+#[test]
+fn transaction_header_is_case_insensitive_and_invalid_text_is_ignored() {
+    let mut headers = HeaderMap::new();
+    assert!(try_get_transaction_id(&headers).is_none());
+    headers.insert("X-Transaction-ID", "contract-transaction-id-0001".parse().unwrap());
+    assert_eq!(try_get_transaction_id(&headers).unwrap().to_string(), "contract-transaction-id-0001");
+    headers.insert("x-transaction-id", hyper::header::HeaderValue::from_bytes(&[0xff]).unwrap());
+    assert!(try_get_transaction_id(&headers).is_none());
+}
+
+#[test]
+fn query_timeout_header_preserves_optional_millisecond_parsing() {
+    let mut headers = HeaderMap::new();
+    assert_eq!(query_timeout(&headers), None);
+    for (text, expected) in [("0", Some(Duration::ZERO)), ("123", Some(Duration::from_millis(123))),
+        ("-1", None), ("invalid", None), ("18446744073709551616", None)] {
+        headers.insert("X-Query-Timeout", text.parse().unwrap());
+        assert_eq!(query_timeout(&headers), expected);
+    }
+}
+
+#[tokio::test]
+async fn chunked_request_body_and_trailers_are_collected_without_losing_bytes() {
+    let f = fixture().await;
+    let address = f.url.strip_prefix("http://").unwrap();
+    let mut socket = tokio::net::TcpStream::connect(address).await.unwrap();
+    socket.write_all(b"POST /echo HTTP/1.1\r\nHost: localhost\r\nX-Contract: request-value\r\nTransfer-Encoding: chunked\r\nTrailer: X-End\r\nConnection: close\r\n\r\n3\r\nabc\r\n3\r\ndef\r\n0\r\nX-End: done\r\n\r\n").await.unwrap();
+    let mut response = Vec::new();
+    tokio::time::timeout(Duration::from_secs(5), socket.read_to_end(&mut response)).await.unwrap().unwrap();
+    assert!(response.starts_with(b"HTTP/1.1 200"));
+    assert!(response.ends_with(b"abcdef"));
+}
+
+#[tokio::test]
+async fn malformed_connection_does_not_stop_accepting_new_clients() {
+    let f = fixture().await;
+    let mut socket = tokio::net::TcpStream::connect(f.url.strip_prefix("http://").unwrap()).await.unwrap();
+    socket.write_all(b"not an HTTP request\r\n\r\n").await.unwrap();
+    socket.shutdown().await.unwrap();
+    let mut ignored = Vec::new();
+    let _ = tokio::time::timeout(Duration::from_secs(5), socket.read_to_end(&mut ignored)).await.unwrap();
+    let response = reqwest::Client::new().get(format!("{}/version", f.url)).send().await.unwrap();
+    assert_eq!(response.status(), 200);
+}
+
+#[tokio::test]
+async fn disconnected_partial_body_does_not_stop_the_listener() {
+    let f = fixture().await;
+    let mut socket = tokio::net::TcpStream::connect(f.url.strip_prefix("http://").unwrap()).await.unwrap();
+    socket.write_all(b"POST /echo HTTP/1.1\r\nHost: localhost\r\nX-Contract: request-value\r\nContent-Length: 100\r\n\r\nshort").await.unwrap();
+    drop(socket);
+    let response = reqwest::Client::new().get(format!("{}/metrics", f.url)).send().await.unwrap();
+    assert_eq!(response.status(), 200);
+}
+
+#[tokio::test]
+async fn http1_keepalive_serves_two_requests_on_the_same_connection() {
+    let f = fixture().await;
+    let socket = tokio::net::TcpStream::connect(f.url.strip_prefix("http://").unwrap()).await.unwrap();
+    let (mut sender, connection) = hyper::client::conn::http1::handshake(hyper_util::rt::TokioIo::new(socket)).await.unwrap();
+    let driver = tokio::spawn(connection);
+    for path in ["/version", "/metrics"] {
+        let request = Request::builder().uri(path).header("host", "localhost").body(ResponseBody::default()).unwrap();
+        let response = sender.send_request(request).await.unwrap();
+        assert_eq!(response.status(), StatusCode::OK);
+        assert!(!response.into_body().collect().await.unwrap().to_bytes().is_empty());
+    }
+    driver.abort();
+}
+
+#[tokio::test]
+async fn cancelling_listener_closes_its_existing_connection_tasks() {
+    let f = fixture().await;
+    let mut socket = tokio::net::TcpStream::connect(f.url.strip_prefix("http://").unwrap()).await.unwrap();
+    socket.write_all(b"GET /version HTTP/1.1\r\nHost: localhost\r\n\r\n").await.unwrap();
+    let mut response = Vec::new();
+    let mut buffer = [0; 256];
+    while !response.ends_with(b"HTTP/1.1") {
+        let count = tokio::time::timeout(Duration::from_secs(5), socket.read(&mut buffer)).await.unwrap().unwrap();
+        assert!(count > 0);
+        response.extend_from_slice(&buffer[..count]);
+    }
+    drop(f);
+    let result = tokio::time::timeout(Duration::from_secs(5), socket.read(&mut buffer)).await.unwrap();
+    assert!(matches!(result, Ok(0) | Err(_)));
+}
+
+#[tokio::test]
+async fn http2_supports_concurrent_requests() {
+    let f = fixture().await;
+    let client = reqwest::Client::builder().http2_prior_knowledge().build().unwrap();
+    let mut tasks = tokio::task::JoinSet::new();
+    for _ in 0..16 {
+        let client = client.clone();
+        let url = format!("{}/metrics", f.url);
+        tasks.spawn(async move {
+            let response = client.get(url).send().await.unwrap();
+            assert_eq!(response.version(), reqwest::Version::HTTP_2);
+            assert_eq!(response.text().await.unwrap(), "# TYPE requests counter\nrequests 1\n");
+        });
+    }
+    while let Some(result) = tasks.join_next().await { result.unwrap(); }
+}
