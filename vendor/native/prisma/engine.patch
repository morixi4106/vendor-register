+++ b/security-contracts/src/mongodb_compression.rs
@@ -0,0 +1,86 @@
+use mongodb::{oja_security_contracts::{compress, decompress}, options::Compressor};
+
+const FLAGS: &[u8] = &[0, 0, 0, 0];
+const SECTION: &[u8] = b"\0synthetic BSON-like wire payload\0\xff\x80";
+
+fn roundtrip(compressor: Compressor, id: u8, flags: &[u8], section: &[u8]) {
+    let compressed = compress(&compressor, flags, section).unwrap();
+    let expected = [flags, section].concat();
+    assert_eq!(decompress(&compressed, id).unwrap(), expected);
+}
+
+#[test]
+fn zstd_preserves_wire_flags_and_section() {
+    roundtrip(Compressor::Zstd { level: None }, 3, FLAGS, SECTION);
+}
+
+#[test]
+fn zstd_handles_empty_message() {
+    roundtrip(Compressor::Zstd { level: None }, 3, &[], &[]);
+}
+
+#[test]
+fn zstd_handles_multiple_stream_buffer_lengths() {
+    let section: Vec<u8> = (0..300_000).map(|i| (i % 251) as u8).collect();
+    roundtrip(Compressor::Zstd { level: None }, 3, FLAGS, &section);
+}
+
+#[test]
+fn zstd_explicit_levels_remain_supported() {
+    for level in [-3, 1, 9] {
+        roundtrip(Compressor::Zstd { level: Some(level) }, 3, FLAGS, SECTION);
+    }
+}
+
+#[test]
+fn zstd_rejects_invalid_frame() {
+    assert!(decompress(b"not a zstd frame", 3).is_err());
+}
+
+#[test]
+fn zstd_rejects_truncated_frame() {
+    let frame = compress(&Compressor::Zstd { level: None }, FLAGS, SECTION).unwrap();
+    assert!(decompress(&frame[..frame.len() - 1], 3).is_err());
+}
+
+#[test]
+fn zstd_corrupt_legacy_frame_returns_error() {
+    // Corrupt v0.4 legacy magic; exercise the driver's real read-decoder path.
+    assert!(decompress(&[0x24, 0xb5, 0x2f, 0xfd, 0, 0], 3).is_err());
+}
+
+#[test]
+fn noop_preserves_every_byte() {
+    assert_eq!(decompress(SECTION, 0).unwrap(), SECTION);
+}
+
+#[test]
+fn unsupported_compressor_is_rejected() {
+    assert!(decompress(SECTION, 255).is_err());
+}
+
+#[test]
+fn zlib_preserves_wire_format() {
+    roundtrip(Compressor::Zlib { level: None }, 2, FLAGS, SECTION);
+}
+
+#[test]
+fn snappy_preserves_wire_format() {
+    roundtrip(Compressor::Snappy, 1, FLAGS, SECTION);
+}
+
+#[test]
+fn other_compressors_reject_corrupt_input() {
+    for id in [1, 2] {
+        assert!(decompress(b"invalid compressed message", id).is_err());
+    }
+}
+
+#[test]
+fn compressor_names_are_unchanged() {
+    use std::str::FromStr;
+    assert!(matches!(Compressor::from_str("zstd").unwrap(), Compressor::Zstd { level: None }));
+    assert!(matches!(Compressor::from_str("zlib").unwrap(), Compressor::Zlib { level: None }));
+    assert_eq!(Compressor::from_str("snappy").unwrap(), Compressor::Snappy);
+    assert!(Compressor::from_str("unknown").is_err());
+}
