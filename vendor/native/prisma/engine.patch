@@ -0,0 +1,121 @@
+use mysql_async::oja_security_contracts::StatementCache;
+use mysql_common::{misc::split_version, scramble::{scramble_native, scramble_sha256}, value::{Value, convert::from_value_opt}};
+
+#[test]
+fn zero_cache_capacity_remains_disabled() {
+    let mut cache = StatementCache::new(0);
+    assert_eq!(cache.put(1, b"first"), None);
+    assert_eq!(cache.get(b"first"), None);
+}
+
+#[test]
+fn cache_lookup_refreshes_eviction_order() {
+    let mut cache = StatementCache::new(2);
+    cache.put(1, b"first");
+    cache.put(2, b"second");
+    assert_eq!(cache.get(b"first"), Some(1));
+    assert_eq!(cache.put(3, b"third"), Some(2));
+    assert_eq!(cache.get(b"second"), None);
+    assert_eq!(cache.get(b"first"), Some(1));
+    assert_eq!(cache.get(b"third"), Some(3));
+}
+
+#[test]
+fn capacity_one_returns_the_evicted_statement() {
+    let mut cache = StatementCache::new(1);
+    assert_eq!(cache.put(1, b"first"), None);
+    assert_eq!(cache.put(2, b"second"), Some(1));
+    assert_eq!(cache.get(b"first"), None);
+    assert_eq!(cache.get(b"second"), Some(2));
+}
+
+#[test]
+fn removal_clears_both_indexes() {
+    let mut cache = StatementCache::new(2);
+    cache.put(1, b"first");
+    cache.remove(1);
+    cache.remove(99);
+    assert_eq!(cache.get(b"first"), None);
+    cache.put(2, b"first");
+    assert_eq!(cache.get(b"first"), Some(2));
+}
+
+#[test]
+fn clear_allows_reuse_without_stale_queries() {
+    let mut cache = StatementCache::new(2);
+    cache.put(1, b"first");
+    cache.put(2, b"second");
+    cache.clear();
+    assert_eq!(cache.get(b"first"), None);
+    assert_eq!(cache.get(b"second"), None);
+    assert_eq!(cache.put(3, b"third"), None);
+    assert_eq!(cache.get(b"third"), Some(3));
+}
+
+#[test]
+fn cache_treats_queries_as_bytes() {
+    let mut cache = StatementCache::new(2);
+    cache.put(1, &[0, 255, 128]);
+    assert_eq!(cache.get(&[0, 255, 128]), Some(1));
+    assert_eq!(cache.get(&[0, 255]), None);
+}
+
+#[test]
+fn replacing_the_same_statement_does_not_evict_another() {
+    let mut cache = StatementCache::new(2);
+    cache.put(1, b"first");
+    cache.put(2, b"second");
+    assert_eq!(cache.put(1, b"first"), None);
+    assert_eq!(cache.get(b"first"), Some(1));
+    assert_eq!(cache.get(b"second"), Some(2));
+}
+
+#[test]
+fn server_version_and_vendor_suffix_are_preserved() {
+    assert_eq!(split_version("8.0.36"), (8, 0, 36));
+    assert_eq!(split_version("10.11.9-MariaDB"), (10, 11, 9));
+    assert_eq!(split_version("invalid"), (0, 0, 0));
+    assert_eq!(split_version("100.200.300"), (0, 0, 0));
+}
+
+#[test]
+fn signed_numeric_boundaries_are_preserved() {
+    for n in [i64::MIN, -1, 0, i64::MAX] {
+        assert_eq!(from_value_opt::<i64>(Value::Bytes(n.to_string().into_bytes())).unwrap(), n);
+    }
+    assert!(from_value_opt::<i64>(Value::Bytes(b"9223372036854775808".to_vec())).is_err());
+}
+
+#[test]
+fn unsigned_numeric_boundaries_are_preserved() {
+    for n in [0, 1, u64::MAX] {
+        assert_eq!(from_value_opt::<u64>(Value::Bytes(n.to_string().into_bytes())).unwrap(), n);
+    }
+    assert!(from_value_opt::<u64>(Value::Bytes(b"-1".to_vec())).is_err());
+    assert!(from_value_opt::<u64>(Value::Bytes(b"18446744073709551616".to_vec())).is_err());
+}
+
+#[test]
+fn float_and_exponent_conversion_are_preserved() {
+    assert_eq!(from_value_opt::<f64>(Value::Bytes(b"-12.5".to_vec())).unwrap(), -12.5);
+    assert_eq!(from_value_opt::<f64>(Value::Bytes(b"1.25e3".to_vec())).unwrap(), 1250.0);
+    assert!(from_value_opt::<f64>(Value::Bytes(b"12.5oops".to_vec())).is_err());
+}
+
+#[test]
+fn native_password_known_vector_is_unchanged() {
+    let nonce = b"NR3HP:qIYa_9=db?Sd{`";
+    assert_eq!(scramble_native(nonce, b"G!ider27").unwrap(), [0x09,0xcf,0xf8,0x85,0x5e,0x9e,0x70,0x53,0x40,0xff,0x22,0x70,0xd8,0xfb,0x9f,0xad,0xba,0x90,0x6b,0x70]);
+}
+
+#[test]
+fn sha256_password_known_vector_is_unchanged() {
+    let nonce = b"NR3HP:qIYa_9=db?Sd{`";
+    assert_eq!(scramble_sha256(nonce, b"G!ider27").unwrap(), [0x4f,0x97,0xbb,0xfd,0x20,0x24,0x01,0xc4,0x2a,0x69,0xde,0xaa,0xe5,0x3b,0xda,0x07,0x7e,0xd7,0x57,0x85,0x63,0xc1,0xa8,0x0e,0xb8,0x16,0xc8,0x21,0x19,0xb6,0x8d,0x2e]);
+}
+
+#[test]
+fn empty_password_remains_no_auth_data() {
+    assert_eq!(scramble_native(b"public fixture nonce", b""), None);
+    assert_eq!(scramble_sha256(b"public fixture nonce", b""), None);
+}
