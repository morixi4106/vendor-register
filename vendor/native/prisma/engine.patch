--- /dev/null
+++ b/query-engine/core/src/interactive_transactions/cache_capacity.rs
@@ -0,0 +1,60 @@
+use lru::LruCache;
+use std::{hash::Hash, num::NonZeroUsize};
+
+pub(super) fn closed_transaction_cache<K: Hash + Eq, V>(configured: usize) -> LruCache<K, V> {
+    // LRU requires a nonzero capacity; a zero setting uses Prisma's existing default.
+    let capacity = NonZeroUsize::new(configured).unwrap_or(NonZeroUsize::new(100).unwrap());
+    LruCache::new(capacity)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn zero_uses_the_existing_default() {
+        assert_eq!(closed_transaction_cache::<u32, u32>(0).cap().get(), 100);
+    }
+
+    #[test]
+    fn positive_capacities_are_preserved() {
+        for capacity in [1, 2, 100, 1024] {
+            assert_eq!(closed_transaction_cache::<u32, u32>(capacity).cap().get(), capacity);
+        }
+    }
+
+    #[test]
+    fn eviction_keeps_the_most_recently_used_transaction() {
+        let mut cache = closed_transaction_cache(2);
+        cache.put("first", 1);
+        cache.put("second", 2);
+        assert_eq!(cache.get("first"), Some(&1));
+        cache.put("third", 3);
+        assert_eq!(cache.len(), 2);
+        assert_eq!(cache.peek("first"), Some(&1));
+        assert_eq!(cache.peek("second"), None);
+        assert_eq!(cache.peek("third"), Some(&3));
+    }
+
+    #[test]
+    fn looking_up_a_closed_transaction_does_not_refresh_its_lifetime() {
+        let mut cache = closed_transaction_cache(2);
+        cache.put("first", 1);
+        cache.put("second", 2);
+        assert_eq!(cache.peek("first"), Some(&1));
+        cache.put("third", 3);
+        assert_eq!(cache.peek("first"), None);
+        assert_eq!(cache.peek("second"), Some(&2));
+    }
+
+    #[test]
+    fn replacement_and_removal_leave_the_cache_usable() {
+        let mut cache = closed_transaction_cache(1);
+        assert_eq!(cache.put("tx", 1), None);
+        assert_eq!(cache.put("tx", 2), Some(1));
+        assert_eq!(cache.pop("tx"), Some(2));
+        cache.put("new", 3);
+        assert_eq!(cache.peek("new"), Some(&3));
+        assert_eq!(cache.len(), 1);
+    }
+}
