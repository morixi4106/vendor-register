+use std::collections::HashSet;
+
+fn assert_v1(value: &str) {
+    assert!((25..=26).contains(&value.len()));
+    assert!(value.starts_with('c'));
+    assert!(value.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit()));
+    assert!(cuid::is_cuid1(value));
+}
+
+fn assert_v2(value: &str, length: usize) {
+    assert_eq!(value.len(), length);
+    assert!(value.as_bytes()[0].is_ascii_lowercase());
+    assert!(value.bytes().all(|b| b.is_ascii_lowercase() || b.is_ascii_digit()));
+    assert!(cuid::is_cuid2(value));
+}
+
+#[test]
+fn base36_known_boundaries_preserve_the_existing_alphabet() {
+    for (number, expected) in [(0u128,"0"),(9,"9"),(10,"a"),(24,"o"),(25,"p"),(26,"q"),(35,"z"),(36,"10"),(1295,"zz"),(1296,"100")] {
+        assert_eq!(cuid_util::to_base_36(number), expected);
+    }
+}
+
+#[test]
+fn base36_full_width_round_trips_without_truncation() {
+    for number in [0u128,1,u32::MAX as u128,u64::MAX as u128,1u128 << 64,1u128 << 127,u128::MAX] {
+        assert_eq!(u128::from_str_radix(&cuid_util::to_base_36(number),36).unwrap(),number);
+    }
+}
+
+#[test]
+fn base36_trait_and_function_remain_identical() {
+    use cuid_util::ToBase36;
+    for number in 0u128..4096 {
+        assert_eq!(number.to_base_36(),cuid_util::to_base_36(number));
+    }
+}
+
+#[test]
+fn existing_v1_order_identifiers_are_still_accepted() {
+    assert_v1("cabcdefghijklmnopqrstuvwx");
+    assert!(!cuid::is_cuid1(""));
+    assert!(!cuid::is_cuid1("too-short"));
+}
+
+#[test]
+fn v1_generation_keeps_the_engine_format() {
+    for _ in 0..128 { assert_v1(&cuid::cuid1()); }
+}
+
+#[test]
+fn v1_small_batch_has_no_duplicate_ids() {
+    let ids: HashSet<_> = (0..1024).map(|_| cuid::cuid1()).collect();
+    assert_eq!(ids.len(),1024);
+}
+
+#[test]
+fn v1_slug_keeps_its_length() {
+    for _ in 0..128 {
+        let slug = cuid::cuid1_slug();
+        assert_eq!(slug.len(),10);
+        assert!(cuid::is_cuid1_slug(&slug));
+    }
+}
+
+#[test]
+fn v2_generation_keeps_the_engine_format() {
+    for _ in 0..128 { assert_v2(&cuid::cuid2(),24); }
