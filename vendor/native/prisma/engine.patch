@@ -0,0 +1,130 @@
+use super::{ResponseBody, response_body, transport};
+use http_body_util::BodyExt;
+use hyper::{Request, Response, body::Incoming};
+use std::time::Duration;
+
+// Exercise the unchanged black-box consumers' Client::new/body/send/text API
+// against loopback only. No Prisma context, database, or provider is involved.
+pub(super) struct Fixture {
+    pub(super) url: String,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+pub(super) async fn fixture() -> Fixture {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let url = format!("http://{}", listener.local_addr().unwrap());
+    let task = tokio::spawn(async move {
+        transport::serve(listener, |req: Request<Incoming>| async move {
+            let response = match req.uri().path() {
+                "/echo" => {
+                    assert_eq!(req.method(), hyper::Method::POST);
+                    assert_eq!(req.headers()["x-contract"], "request-value");
+                    let bytes = req.into_body().collect().await?.to_bytes();
+                    Response::builder()
+                        .header("content-type", "application/json")
+                        .header("qe-content-length", bytes.len())
+                        .body(response_body(bytes))
+                        .unwrap()
+                }
+                "/metrics" => Response::new(response_body("# TYPE requests counter\nrequests 1\n")),
+                "/redirect" => Response::builder().status(302).header("location", "/metrics")
+                    .body(ResponseBody::default()).unwrap(),
+                "/error" => Response::builder().status(422)
+                    .body(response_body(r#"{"is_panic":false,"message":"invalid protocol"}"#)).unwrap(),
+                "/malformed" => Response::new(response_body("not-json")),
+                "/version" => Response::new(response_body(format!("{:?}", req.version()))),
+                "/slow" => {
+                    tokio::time::sleep(Duration::from_secs(5)).await;
+                    Response::new(ResponseBody::default())
+                }
+                "/utf8" => Response::builder().header("content-type", "text/plain; charset=utf-8")
+                    .body(response_body("\u{65e5}\u{672c}\u{8a9e}".as_bytes())).unwrap(),
+                _ => Response::builder().status(404).body(ResponseBody::default()).unwrap(),
+            };
+            Ok::<_, hyper::Error>(response)
+        }).await.unwrap();
+    });
+    Fixture { url, task }
+}
+
+#[tokio::test]
+async fn post_body_headers_and_response_length_are_preserved() {
+    let f = fixture().await;
+    let payload = r#"{"action":"findMany","modelName":"Person","query":{}}"#;
+    let response = reqwest::Client::new().post(format!("{}/echo", f.url))
+        .header("x-contract", "request-value").body(payload).send().await.unwrap();
+    assert_eq!(response.status(), reqwest::StatusCode::OK);
+    assert_eq!(response.headers()["content-type"], "application/json");
+    assert_eq!(response.headers()["qe-content-length"], payload.len().to_string());
+    assert_eq!(response.text().await.unwrap(), payload);
+}
+
+#[tokio::test]
+async fn metrics_text_is_not_reencoded() {
+    let f = fixture().await;
+    let response = reqwest::Client::new().get(format!("{}/metrics", f.url)).send().await.unwrap();
+    assert_eq!(response.text().await.unwrap(), "# TYPE requests counter\nrequests 1\n");
+}
+
+#[tokio::test]
+async fn non_success_status_and_error_body_remain_available() {
+    let f = fixture().await;
+    let response = reqwest::Client::new().post(format!("{}/error", f.url)).send().await.unwrap();
+    assert_eq!(response.status(), reqwest::StatusCode::UNPROCESSABLE_ENTITY);
+    let value: serde_json::Value = serde_json::from_str(&response.text().await.unwrap()).unwrap();
+    assert_eq!(value["is_panic"], false);
+    assert_eq!(value["message"], "invalid protocol");
+}
+
+#[tokio::test]
+async fn default_relative_redirects_are_followed() {
+    let f = fixture().await;
+    let response = reqwest::Client::new().get(format!("{}/redirect", f.url)).send().await.unwrap();
+    assert_eq!(response.status(), 200);
+    assert_eq!(response.url().path(), "/metrics");
+}
+
+#[tokio::test]
+async fn invalid_json_remains_an_explicit_decode_error() {
+    let f = fixture().await;
+    let response = reqwest::Client::new().get(format!("{}/malformed", f.url)).send().await.unwrap();
+    assert!(serde_json::from_str::<serde_json::Value>(&response.text().await.unwrap()).is_err());
+}
+
+#[tokio::test]
+async fn explicitly_configured_timeout_remains_an_error() {
+    let f = fixture().await;
+    let error = reqwest::Client::builder().timeout(Duration::from_millis(100)).build().unwrap()
+        .get(format!("{}/slow", f.url)).send().await.unwrap_err();
+    assert!(error.is_timeout());
+}
+
+#[tokio::test]
+async fn http1_remains_supported() {
+    let f = fixture().await;
+    let response = reqwest::Client::new().get(format!("{}/version", f.url)).send().await.unwrap();
+    assert_eq!(response.version(), reqwest::Version::HTTP_11);
+    assert_eq!(response.text().await.unwrap(), "HTTP/1.1");
+}
+
+#[tokio::test]
+async fn http2_prior_knowledge_remains_supported() {
+    let f = fixture().await;
+    let response = reqwest::Client::builder().http2_prior_knowledge().build().unwrap()
+        .get(format!("{}/version", f.url)).send().await.unwrap();
+    assert_eq!(response.version(), reqwest::Version::HTTP_2);
+    assert_eq!(response.text().await.unwrap(), "HTTP/2.0");
+}
+
+#[tokio::test]
+async fn charset_decoding_remains_enabled() {
+    let f = fixture().await;
+    let response = reqwest::Client::new().get(format!("{}/utf8", f.url)).send().await.unwrap();
+    assert_eq!(response.text().await.unwrap(), "\u{65e5}\u{672c}\u{8a9e}");
+}
diff --git a/query-engine/query-engine/src/server/transport.rs b/query-engine/query-engine/src/server/transport.rs
new file mode 100644
--- /dev/null
+++ b/query-engine/query-engine/src/server/transport.rs
@@ -0,0 +1,50 @@
+use super::ResponseBody;
+use hyper::{Request, Response, body::Incoming, service::service_fn};
+use hyper_util::{rt::{TokioExecutor, TokioIo}, server::conn::auto::Builder};
+use std::{future::Future, io};
+use tokio::{net::TcpListener, task::JoinSet};
+
+pub(super) async fn serve<F, Fut>(listener: TcpListener, handler: F) -> io::Result<()>
+where
+    F: Fn(Request<Incoming>) -> Fut + Clone + Send + Sync + 'static,
+    Fut: Future<Output = Result<Response<ResponseBody>, hyper::Error>> + Send + 'static,
+{
+    // Own the connection tasks so cancellation also closes existing sockets.
+    let mut connections = JoinSet::new();
+    loop {
+        tokio::select! {
+            accepted = listener.accept() => {
+                let (stream, _) = match accepted {
+                    Ok(connection) => connection,
+                    Err(error) => {
+                        if matches!(error.kind(), io::ErrorKind::ConnectionRefused |
+                            io::ErrorKind::ConnectionAborted | io::ErrorKind::ConnectionReset) {
+                            continue;
+                        }
+                        // Retain the old acceptor's backoff on resource exhaustion.
+                        tracing::warn!("http accept error: {error}");
+                        tokio::time::sleep(std::time::Duration::from_secs(1)).await;
+                        continue;
+                    }
+                };
+                if let Err(error) = stream.set_nodelay(true) {
+                    tracing::debug!("http socket configuration error: {error}");
+                    continue;
+                }
+                let handler = handler.clone();
+                connections.spawn(async move {
+                    if let Err(error) = Builder::new(TokioExecutor::new())
+                        .serve_connection(TokioIo::new(stream), service_fn(handler)).await
+                    {
+                        tracing::debug!("http connection error: {error}");
+                    }
+                });
+            }
+            Some(result) = connections.join_next(), if !connections.is_empty() => {
+                if let Err(error) = result {
+                    tracing::warn!("http connection task failed: {error}");
+                }
+            }
+        }
+    }
+}
