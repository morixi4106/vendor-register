@@ -0,0 +1,38 @@
+#![deny(unsafe_code)]
+#![allow(dead_code)]
+
+// Compile the actual patched engine modules, not copies of their implementations.
+#[path = "../../query-engine/core/src/interactive_transactions/cache_capacity.rs"]
+mod cache_capacity;
+#[path = "../../schema-engine/connectors/schema-connector/src/checksum.rs"]
+mod checksum;
+
+#[cfg(test)]
+mod tests {
+    use super::checksum;
+
+    #[test]
+    fn empty_migration_keeps_its_sha256() {
+        assert_eq!(checksum::render_checksum(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
+    }
+
+    #[test]
+    fn an_existing_checksum_is_accepted_but_changed_sql_is_not() {
+        let script = "CREATE TABLE example (id INTEGER);\n";
+        let digest = checksum::render_checksum(script);
+        assert!(checksum::script_matches_checksum(script, &digest));
+        assert!(!checksum::script_matches_checksum("DROP TABLE example;\n", &digest));
+        assert!(checksum::script_matches_checksum(&script.replace('\n', "\r\n"), &digest));
+    }
+
+    #[test]
+    fn legacy_unpadded_checksums_remain_readable() {
+        let script = "hello";
+        let digest = checksum::render_checksum(script);
+        let legacy: String = digest.as_bytes().chunks_exact(2).map(|pair| {
+            let pair = std::str::from_utf8(pair).unwrap();
+            format!("{:x}", u8::from_str_radix(pair, 16).unwrap())
+        }).collect();
+        assert!(checksum::script_matches_checksum(script, &legacy));
+    }
+}
