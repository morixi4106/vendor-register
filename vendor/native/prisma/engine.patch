+#[test]
+fn v2_small_multithreaded_batch_has_no_duplicates() {
+    let handles: Vec<_> = (0..8).map(|_| std::thread::spawn(|| (0..32).map(|_| cuid::cuid2()).collect::<Vec<_>>())).collect();
+    let ids: Vec<_> = handles.into_iter().flat_map(|handle| handle.join().unwrap()).collect();
+    for id in &ids { assert_v2(id,24); }
