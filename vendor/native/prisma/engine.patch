+    }
+}
+
+#[test]
+fn v2_custom_lengths_and_callbacks_remain_usable() {
+    for length in [2u16,8,16,32] {
+        let generator = cuid::Cuid2Constructor::new().with_length(length)
+            .with_counter(|| 42).with_fingerprinter(|| "synthetic-fingerprint".to_owned());
+        assert_v2(&generator.create_id(),length as usize);
+    }
+    let mut generator = cuid::Cuid2Constructor::default();
+    generator.set_length(16);
+    generator.set_counter(|| 7);
+    generator.set_fingerprinter(|| "synthetic-fingerprint".to_owned());
+    assert_v2(&generator.create_id(),16);
+}
+
+#[test]
+fn v2_rejects_lengths_below_two() {
+    for length in [0u16,1] {
+        assert!(std::panic::catch_unwind(|| cuid::Cuid2Constructor::new().with_length(length)).is_err());
+    }
+}
