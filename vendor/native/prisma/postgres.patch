diff --git a/tokio-postgres/src/row/oja_security_contracts.rs b/tokio-postgres/src/row/oja_security_contracts.rs
new file mode 100644
--- /dev/null
+++ b/tokio-postgres/src/row/oja_security_contracts.rs
@@ -0,0 +1,24 @@
+use super::*;
+use bytes::BytesMut;
+use postgres_protocol::message::backend::Message;
+
+fn body(packet: &[u8]) -> Result<DataRowBody, Error> {
+    let mut buffer = BytesMut::from(packet);
+    match Message::parse(&mut buffer).map_err(Error::parse)? {
+        Some(Message::DataRow(body)) if buffer.is_empty() => Ok(body),
+        _ => Err(Error::parse(io::Error::new(io::ErrorKind::InvalidData, "expected one complete DataRow"))),
+    }
+}
+
+pub fn row(names: &[&str], packet: &[u8]) -> Result<Row, Error> {
+    let columns = names.iter().map(|name| Column {
+        name: (*name).to_owned(), table_oid: None, column_id: None,
+        type_modifier: 0, r#type: Type::TEXT,
+    }).collect();
+    Row::new(Statement::unnamed(vec![], columns), body(packet)?)
+}
+
+pub fn simple_row(names: &[&str], packet: &[u8]) -> Result<SimpleQueryRow, Error> {
+    let columns = names.iter().map(|name| SimpleColumn::new((*name).to_owned())).collect::<Vec<_>>().into();
+    SimpleQueryRow::new(columns, body(packet)?)
+}
