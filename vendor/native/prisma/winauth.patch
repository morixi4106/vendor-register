+fn invalid_ntlm(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+fn take_ntlm<'a>(bytes: &mut &'a [u8], len: usize) -> io::Result<&'a [u8]> {
+    let (value, remaining) = (*bytes).split_at_checked(len).ok_or_else(|| {
+        io::Error::new(io::ErrorKind::UnexpectedEof, "truncated NTLM field")
+    })?;
+    *bytes = remaining;
+    Ok(value)
+}
+
+fn wire_length(len: usize) -> io::Result<u16> {
+    u16::try_from(len).map_err(|_| invalid_ntlm("NTLM field exceeds its 16-bit length"))
+}
+
+fn unicode_wire_length(value: &str) -> io::Result<u16> {
+    let len = value.encode_utf16().count().checked_mul(2)
+        .ok_or_else(|| invalid_ntlm("NTLM Unicode length overflow"))?;
+    wire_length(len)
+}
