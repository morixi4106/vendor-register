+++ b/src/oja_parser_contracts.rs
@@ -0,0 +1,311 @@
+//! Offline boundary regressions for the actual NTLM implementation.
+use super::*;
+
+fn unicode(value: &str) -> Vec<u8> {
+    value.encode_utf16().flat_map(u16::to_le_bytes).collect()
+}
+
+fn pair(id: u16, value: &[u8]) -> Vec<u8> {
+    let mut bytes = vec![];
+    bytes.write_u16::<LittleEndian>(id).unwrap();
+    bytes.write_u16::<LittleEndian>(u16::try_from(value.len()).unwrap()).unwrap();
+    bytes.extend_from_slice(value);
+    bytes
+}
+
+fn info() -> Vec<u8> {
+    let mut bytes = pair(3, &unicode("fake.invalid"));
+    bytes.extend(pair(7, &42u64.to_le_bytes()));
+    bytes.extend_from_slice(&[0; 4]);
+    bytes
+}
+
+fn token(name: Option<&[u8]>, info: Option<&[u8]>, reverse: bool, padding: usize, version: bool) -> Vec<u8> {
+    let mut flags = NegotiateFlags::NTLMSSP_NEGOTIATE_128
+        | NegotiateFlags::NTLMSSP_NEGOTIATE_KEY_EXCH
+        | NegotiateFlags::NTLMSSP_NEGOTIATE_EXTENDED_SESSIONSECURITY
+        | NegotiateFlags::NTLMSSP_NEGOTIATE_ALWAYS_SIGN
+        | NegotiateFlags::NTLMSSP_NEGOTIATE_SEAL
+        | NegotiateFlags::NTLMSSP_NEGOTIATE_UNICODE;
+    flags.set(NegotiateFlags::NTLMSSP_REQUEST_TARGET, name.is_some());
+    flags.set(NegotiateFlags::NTLMSSP_NEGOTIATE_TARGET_INFO, info.is_some());
+    flags.set(NegotiateFlags::NTLMSSP_NEGOTIATE_VERSION, version);
+    let mut bytes = vec![0; if version { 56 } else { 48 }];
+    bytes[..8].copy_from_slice(SIGNATURE);
+    LittleEndian::write_u32(&mut bytes[8..12], 2);
+    LittleEndian::write_u32(&mut bytes[20..24], flags.bits());
+    bytes[24..32].copy_from_slice(b"12345678");
+    LittleEndian::write_u32(&mut bytes[16..20], u32::MAX);
+    LittleEndian::write_u32(&mut bytes[44..48], u32::MAX);
+    bytes.resize(bytes.len() + padding, 0xaa);
+    let fields = if reverse { [(40, info), (12, name)] } else { [(12, name), (40, info)] };
+    for (field, value) in fields {
+        if let Some(value) = value {
+            let offset = bytes.len() as u32;
+            LittleEndian::write_u16(&mut bytes[field..field+2], u16::try_from(value.len()).unwrap());
+            LittleEndian::write_u16(&mut bytes[field+2..field+4], u16::try_from(value.len()).unwrap());
+            LittleEndian::write_u32(&mut bytes[field+4..field+8], offset);
+            bytes.extend_from_slice(value);
+        }
+    }
+    bytes
+}
+
+fn client() -> NtlmV2Client<'static> {
+    let mut client = NtlmV2ClientBuilder::new().target_spn("MSSQLSvc/fake.invalid:1433")
+        .channel_bindings(b"offline-binding").build(Some("Domain"), "User", "Password");
+    client.workstation = Some("OFFLINE_FIXTURE".into());
+    client
+}
+
+fn field(message: &[u8], position: usize) -> &[u8] {
+    let size = LittleEndian::read_u16(&message[position..]) as usize;
+    let offset = LittleEndian::read_u32(&message[position+4..]) as usize;
+    &message[offset..offset+size]
+}
+
+fn verify_mic(client: &NtlmV2Client<'_>, negotiate: &[u8], challenge: &[u8], auth: &[u8]) {
+    let response = field(auth, 20);
+    let key = ntowfv2(&client.user, &client.password, client.domain.as_deref().unwrap_or(""));
+    let mut proof_input = b"12345678".to_vec(); proof_input.extend_from_slice(&response[16..]);
+    assert_eq!(&response[..16], Md5::hmac(&key, &proof_input));
+    let base = Md5::hmac(&key, &response[..16]);
+    let session = rc4::rc4(&base, field(auth, 52));
+    let mut content = negotiate.to_vec(); content.extend_from_slice(challenge);
+    let mut cleared = auth.to_vec(); cleared[72..88].fill(0); content.extend(cleared);
+    assert_eq!(&auth[72..88], Md5::hmac(&session, &content));
+}
+
+pub fn absent_target_full_exchange() {
+    let mut bytes = token(None, Some(&info()), false, 0, false);
+    LittleEndian::write_u32(&mut bytes[16..20], 0);
+    let mut c = client(); let negotiate = c.next_bytes(None).unwrap().unwrap();
+    let auth = c.next_bytes(Some(&bytes)).unwrap().unwrap();
+    verify_mic(&c, &negotiate, &bytes, &auth);
+}
+
+pub fn absent_info_ignores_bytes() {
+    let mut bytes = token(Some(&unicode("D")), None, false, 0, false);
+    LittleEndian::write_u16(&mut bytes[40..42], u16::MAX);
+    let parsed = ChallengeMessage::decode(&bytes).unwrap();
+    assert_eq!(parsed.target_name.as_deref(), Some("D")); assert!(parsed.av_pairs.is_empty());
+}
+
+pub fn absent_fields_ignore_offsets() {
+    let bytes = token(None, None, false, 0, false);
+    let parsed = ChallengeMessage::decode(&bytes).unwrap();
+    assert!(parsed.target_name.is_none()); assert!(parsed.av_pairs.is_empty());
+    let mut bytes = token(Some(&[]), Some(&[]), false, 0, false);
+    LittleEndian::write_u32(&mut bytes[16..20], 0);
+    LittleEndian::write_u32(&mut bytes[44..48], u32::MAX);
+    assert!(ChallengeMessage::decode(&bytes).is_ok());
+}
+
+pub fn max_lengths_ignored() {
+    let mut bytes = token(Some(&unicode("D")), Some(&info()), false, 0, false);
+    LittleEndian::write_u16(&mut bytes[14..16], 0);
+    LittleEndian::write_u16(&mut bytes[42..44], u16::MAX);
+    assert!(ChallengeMessage::decode(&bytes).is_ok());
+}
+
+pub fn payload_orders_and_padding() {
+    for reverse in [false, true] { for padding in [0, 2, 16] {
+        let mut bytes = token(Some(&unicode("Domain")), Some(&info()), reverse, padding, false);
+        bytes.extend_from_slice(b"ignored payload padding");
+        let parsed = ChallengeMessage::decode(&bytes).unwrap();
+        assert_eq!(parsed.target_name.as_deref(), Some("Domain")); assert_eq!(parsed.av_pairs.len(), 2);
+    }}
+}
+
+pub fn version_header_boundaries() {
+    let bytes = token(Some(&unicode("D")), Some(&info()), false, 0, true);
+    assert!(ChallengeMessage::decode(&bytes).is_ok());
+    for prefix in 48..56 { assert!(ChallengeMessage::decode(&bytes[..prefix]).is_err()); }
+    let mut bad = bytes; LittleEndian::write_u32(&mut bad[16..20], 54);
+    assert!(ChallengeMessage::decode(&bad).is_err());
+}
+
+pub fn truncated_header_prefixes() {
+    let bytes = token(None, None, false, 0, false);
+    for prefix in 0..48 { assert!(ChallengeMessage::decode(&bytes[..prefix]).is_err()); }
+}
+
+pub fn active_offsets_rejected() {
+    for field in [16, 44] { for offset in [0, 1, 47, 65535, 0x80000000, u32::MAX] {
+        let mut bytes = token(Some(&unicode("D")), Some(&info()), false, 0, false);
+        LittleEndian::write_u32(&mut bytes[field..field+4], offset);
+        assert!(ChallengeMessage::decode(&bytes).is_err());
+    }}
+}
+
+pub fn overlapping_fields_rejected() {
+    for reverse in [false, true] {
+        let mut bytes = token(Some(&unicode("Domain")), Some(&info()), reverse, 0, false);
+        let offset = LittleEndian::read_u32(&bytes[16..20]);
+        LittleEndian::write_u32(&mut bytes[44..48], offset);
+        assert!(ChallengeMessage::decode(&bytes).is_err());
+    }
+}
+
+pub fn payload_lengths_bounded() {
+    for field in [12, 40] {
+        let mut bytes = token(Some(&unicode("D")), Some(&info()), false, 0, false);
+        LittleEndian::write_u16(&mut bytes[field..field+2], u16::MAX);
+        assert!(ChallengeMessage::decode(&bytes).is_err());
+    }
+}
+
+pub fn unicode_name_alignment() {
+    let bytes = token(Some(&unicode("D")), Some(&info()), false, 1, false);
+    assert!(ChallengeMessage::decode(&bytes).is_err());
+    let bytes = token(None, Some(&info()), false, 1, false);
+    assert!(ChallengeMessage::decode(&bytes).is_ok());
+}
+
+pub fn unicode_decoder_rejects_invalid() {
+    for value in [&[0x00, 0xd8][..], &[b'A'][..]] {
+        let bytes = token(Some(value), Some(&info()), false, 0, false);
+        assert!(ChallengeMessage::decode(&bytes).is_err());
+    }
+    let mut tiny = &b"A\0"[..];
+    assert!(tiny.decode_unicode_string(usize::MAX - 1, "offline").is_err());
+    let bytes = token(Some(&unicode("A\u{1f600}\u{65e5}")), Some(&info()), false, 0, false);
+    assert_eq!(ChallengeMessage::decode(&bytes).unwrap().target_name.as_deref(), Some("A\u{1f600}\u{65e5}"));
+}
+
+pub fn av_eol_and_trailing_bytes() {
+    for av in [pair(3, &unicode("fake.invalid")), vec![0,0,1,0,0], vec![0,0,0,0,1]] {
+        assert!(ChallengeMessage::decode(&token(None, Some(&av), false, 0, false)).is_err());
+    }
+    assert!((&b""[..]).decode_av_pairs().is_err());
+}
+
+pub fn av_cannot_escape_info_length() {
+    for len in [1, 2, 4, 8] {
+        let mut bytes = token(None, Some(&info()), false, 0, false);
+        LittleEndian::write_u16(&mut bytes[40..42], len);
+        assert!(ChallengeMessage::decode(&bytes).is_err());
+    }
+}
+
+pub fn av_scalar_lengths() {
+    for (id, width) in [(6,4), (7,8), (10,16)] {
+        for len in [0,1,2,3,4,5,7,8,9,15,16,17,65535] {
+            let mut av = pair(id, &vec![0;len]); av.extend_from_slice(&[0;4]);
+            let result = av.as_slice().decode_av_pairs();
+            assert_eq!(result.is_ok(), len == width);
+        }
+    }
+    let mut av = pair(6, &0x80u32.to_le_bytes()); av.extend_from_slice(&[0;4]);
+    assert!(av.as_slice().decode_av_pairs().is_err());
+}
+
+pub fn av_unknown_and_single_host_error() {
+    let mut value = [0;48]; LittleEndian::write_u32(&mut value[..4], 48);
+    for id in [8, 0xffff] {
+        let mut av = pair(id, &value); av.extend_from_slice(&[0;4]);
+        assert!(ChallengeMessage::decode(&token(None, Some(&av), false, 0, false)).is_err());
+    }
+}
+
+pub fn av_strings_and_unaligned_info() {
+    for id in [1,2,3,4,5,9] {
+        let mut av = pair(id, &unicode("A\u{1f600}\u{65e5}")); av.extend_from_slice(&[0;4]);
+        let parsed = ChallengeMessage::decode(&token(None, Some(&av), false, 1, false)).unwrap();
+        let text = match &parsed.av_pairs[0] {
+            AvItem::NbComputerName(s) | AvItem::NbDomainName(s) | AvItem::DnsComputerName(s)
+            | AvItem::DnsDomainName(s) | AvItem::DnsTreeName(s) | AvItem::AvTargetName(s) => s,
+            _ => panic!("wrong AV type"),
+        };
+        assert_eq!(text, "A\u{1f600}\u{65e5}");
+        for bad in [&[b'A'][..], &[0x00,0xd8][..]] {
+            let mut av = pair(id, bad); av.extend_from_slice(&[0;4]);
+            assert!(ChallengeMessage::decode(&token(None, Some(&av), false, 0, false)).is_err());
+        }
+    }
+}
+
+pub fn av_truncation_corpus() {
+    let av = info();
+    for end in 1..av.len() {
+        assert!(ChallengeMessage::decode(&token(None, Some(&av[..end]), false, 0, false)).is_err());
+    }
+}
+
+pub fn deterministic_malformed_corpus() {
+    let original = token(Some(&unicode("Domain")), Some(&info()), false, 0, false);
+    let mut state = 0x12345678u32;
+    for index in 0..4096 {
+        let mut bytes = original.clone();
+        for _ in 0..3 {
+            state ^= state << 13; state ^= state >> 17; state ^= state << 5;
+            let position = state as usize % bytes.len(); bytes[position] ^= (state >> 24) as u8;
+        }
+        if index % 4 == 0 { bytes.truncate(index % original.len()); }
+        let _result = ChallengeMessage::decode(&bytes);
+        if index % 8 == 0 {
+            let mut c = client(); c.next_bytes(None).unwrap(); let _result = c.next_bytes(Some(&bytes));
+        }
+    }
+}
+
+pub fn av_unicode_wire_lengths() {
+    let mut bytes = vec![];
+    bytes.encode_av_pairs(&[AvItem::DnsComputerName("A\u{1f600}\u{65e5}".into())]).unwrap();
+    assert_eq!(LittleEndian::read_u16(&bytes[2..4]), 8);
+    assert_eq!(&bytes[4..12], &[0x41,0,0x3d,0xd8,0,0xde,0xe5,0x65]);
+    assert!(bytes.as_slice().decode_av_pairs().is_ok());
+}
+
+pub fn auth_unicode_fields_and_mic() {
+    let mut c = NtlmV2ClientBuilder::new().target_spn("MSSQLSvc/fake.invalid:1433")
+        .channel_bindings(b"offline-binding")
+        .build(Some("D\u{1f600}"), "U\u{65e5}", "Password");
+    c.workstation = Some("W\u{1f600}".into());
+    let mut av = pair(3, &unicode("fake\u{65e5}.invalid"));
+    av.extend(pair(7, &42u64.to_le_bytes())); av.extend_from_slice(&[0;4]);
+    let bytes = token(None, Some(&av), false, 0, false);
+    let negotiate = c.next_bytes(None).unwrap().unwrap();
+    let auth = c.next_bytes(Some(&bytes)).unwrap().unwrap();
+    assert_eq!(field(&auth,28), unicode("D\u{1f600}"));
+    assert_eq!(field(&auth,36), unicode("U\u{65e5}"));
+    assert_eq!(field(&auth,44), unicode("W\u{1f600}"));
+    verify_mic(&c, &negotiate, &bytes, &auth);
+}
+
+fn auth(response: &[u8], domain: &str) -> io::Result<Vec<u8>> {
+    AuthenticateMessage { domain: Some(domain.into()), user: "User".into(),
+        workstation: None, nt_challenge_response: response,
+        encrypted_random_session_key: &[0;16], exported_session_key: &[0;16],
+        mic_content: None, negotiate_flags: NegotiateFlags::empty() }.encode()
+}
+
+pub fn outgoing_wire_length_boundaries() {
+    assert_eq!(wire_length(65535).unwrap(), u16::MAX); assert!(wire_length(65536).is_err());
+    assert_eq!(unicode_wire_length(&"a".repeat(32767)).unwrap(), 65534);
+    let oversized = "a".repeat(32768);
+    assert!(unicode_wire_length(&oversized).is_err());
+    assert!(Vec::new().encode_av_pairs(&[AvItem::DnsComputerName(oversized.clone())]).is_err());
+    assert!(auth(&[0;32], &oversized).is_err());
+    assert!(auth(&vec![0;65534], "Domain").is_ok());
+    assert!(auth(&vec![0;65536], "Domain").is_err());
+    assert!(auth(&[0;31], "Domain").is_err());
+}
+
+pub fn oversized_response_rejected() {
+    let mut av = pair(3, &unicode(&"a".repeat(32740)));
+    av.extend(pair(7, &42u64.to_le_bytes())); av.extend_from_slice(&[0;4]);
+    let bytes = token(None, Some(&av), false, 0, false);
+    let mut c = client(); let negotiate = c.next_bytes(None).unwrap().unwrap();
+    assert!(c.next_bytes(Some(&bytes)).is_err()); assert_eq!(c.all_bytes, negotiate);
+}
+
+pub fn failed_challenges_do_not_accumulate() {
+    let mut c = client(); let negotiate = c.next_bytes(None).unwrap().unwrap();
+    for _ in 0..512 {
+        assert!(c.next_bytes(Some(b"invalid challenge")).is_err()); assert_eq!(c.all_bytes, negotiate);
+    }
+    let bytes = token(None, Some(&info()), false, 0, false);
+    let auth = c.next_bytes(Some(&bytes)).unwrap().unwrap(); verify_mic(&c, &negotiate, &bytes, &auth);
+    assert!(c.next_bytes(None).unwrap().is_none());
+}
