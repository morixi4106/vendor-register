+++ b/vendor/env-logger-bridge/src/lib.rs
@@ -0,0 +1,60 @@
+// The retained feature name maps to env_logger's Jiff-backed timestamps.
+pub use shared::*;
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use log::{Level, LevelFilter, Log, Metadata, Record};
+    use std::io::{self, Write};
+    use std::sync::{Arc, Mutex};
+
+    #[derive(Clone)]
+    struct Buffer(Arc<Mutex<Vec<u8>>>);
+
+    impl Write for Buffer {
+        fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+            self.0.lock().unwrap().extend_from_slice(bytes);
+            Ok(bytes.len())
+        }
+
+        fn flush(&mut self) -> io::Result<()> {
+            Ok(())
+        }
+    }
+
+    #[test]
+    fn consumed_builder_and_initialization_signatures_remain_available() {
+        let _: fn() = init;
+        let _: fn() -> Result<(), log::SetLoggerError> = try_init;
+        let logger = Builder::new()
+            .is_test(true)
+            .filter_level(LevelFilter::Warn)
+            .build();
+        assert!(logger.enabled(&Metadata::builder().level(Level::Warn).build()));
+        assert!(!logger.enabled(&Metadata::builder().level(Level::Info).build()));
+    }
+
+    #[test]
+    fn timestamp_and_custom_formatting_are_backed_by_the_new_logger() {
+        let buffer = Buffer(Arc::new(Mutex::new(Vec::new())));
+        let logger = Builder::new()
+            .filter_level(LevelFilter::Info)
+            .write_style(WriteStyle::Never)
+            .target(Target::Pipe(Box::new(buffer.clone())))
+            .build();
+        logger.log(&Record::builder().args(format_args!("timestamp-probe")).level(Level::Info).build());
+        let output = String::from_utf8(buffer.0.lock().unwrap().clone()).unwrap();
+        assert!(output.starts_with('['));
+        assert!(output.contains(" INFO"));
+        assert!(output.ends_with("timestamp-probe\n"));
+
+        let custom = Buffer(Arc::new(Mutex::new(Vec::new())));
+        let logger = Builder::new()
+            .filter_level(LevelFilter::Info)
+            .format(|buffer, record| writeln!(buffer, "{}:{}", record.level(), record.args()))
+            .target(Target::Pipe(Box::new(custom.clone())))
+            .build();
+        logger.log(&Record::builder().args(format_args!("custom-probe")).level(Level::Info).build());
+        assert_eq!(&*custom.0.lock().unwrap(), b"INFO:custom-probe\n");
+    }
+}
