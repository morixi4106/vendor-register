diff --git a/vendor/jit-debug-bridge/Cargo.toml b/vendor/jit-debug-bridge/Cargo.toml
new file mode 100644
index 0000000..7d62ba4
--- /dev/null
+++ b/vendor/jit-debug-bridge/Cargo.toml
@@ -0,0 +1,14 @@
+[package]
+name = "wasmtime-internal-jit-debug"
+version = "48.0.8+oja.1"
+edition = "2024"
+license = "Apache-2.0 WITH LLVM-exception"
+description = "Share the byte-identical Wasmtime JIT debug API and registration lock"
+
+[dependencies]
+shared = { package = "wasmtime-internal-jit-debug", version = "=50.0.1", default-features = false }
+
+[features]
+std = ["shared/std"]
+gdb_jit_int = ["shared/gdb_jit_int"]
+perf_jitdump = ["shared/perf_jitdump", "std"]
diff --git a/vendor/jit-debug-bridge/src/lib.rs b/vendor/jit-debug-bridge/src/lib.rs
new file mode 100644
index 0000000..4b03f8e
--- /dev/null
+++ b/vendor/jit-debug-bridge/src/lib.rs
@@ -0,0 +1,90 @@
+#![no_std]
+
+// Both engines use one descriptor and mutex; forwarding only C symbols would race.
+pub use shared::*;
+
+#[cfg(all(test, feature = "std", feature = "gdb_jit_int"))]
+mod tests {
+    extern crate std;
+    use core::ptr;
+    use std::{thread, vec};
+
+    #[repr(C)]
+    struct Entry {
+        next: *mut Entry,
+        previous: *mut Entry,
+        address: *const u8,
+        size: u64,
+    }
+
+    #[repr(C)]
+    struct Descriptor {
+        version: u32,
+        action: u32,
+        relevant: *mut Entry,
+        first: *mut Entry,
+    }
+
+    unsafe extern "C" {
+        static mut __jit_debug_descriptor: Descriptor;
+    }
+
+    // Call only outside registration and after every worker has joined.
+    fn entries() -> usize {
+        unsafe {
+            let descriptor = &*ptr::addr_of!(__jit_debug_descriptor);
+            assert_eq!(descriptor.version, 1);
+            assert_eq!(descriptor.action, 0);
+            assert!(descriptor.relevant.is_null());
+            let mut cursor = descriptor.first;
+            let mut previous = ptr::null_mut();
+            let mut count = 0;
+            while !cursor.is_null() {
+                assert_eq!((*cursor).previous, previous);
+                assert!(!(*cursor).address.is_null());
+                assert!((*cursor).size > 0);
+                previous = cursor;
+                cursor = (*cursor).next;
+                count += 1;
+                assert!(count <= 100);
+            }
+            count
+        }
+    }
+
+    #[test]
+    fn both_aliases_share_type_descriptor_and_registration() {
+        assert_eq!(entries(), 0);
+        let first: shared::gdb_jit_int::GdbJitImageRegistration =
+            crate::gdb_jit_int::GdbJitImageRegistration::register(vec![1, 2, 3]);
+        let second = shared::gdb_jit_int::GdbJitImageRegistration::register(vec![4]);
+        assert_eq!(first.file(), &[1, 2, 3]);
+        assert_eq!(entries(), 2);
+        drop(first);
+        assert_eq!(entries(), 1);
+        drop(second);
+        assert_eq!(entries(), 0);
+    }
+
+    #[test]
+    fn both_aliases_share_the_registration_lock() {
+        assert_eq!(entries(), 0);
+        let handles: std::vec::Vec<_> = (0..8)
+            .map(|_| {
+                thread::spawn(|| {
+                    for _ in 0..50 {
+                        let a = crate::gdb_jit_int::GdbJitImageRegistration::register(vec![1]);
+                        let b = shared::gdb_jit_int::GdbJitImageRegistration::register(vec![2]);
+                        thread::yield_now();
+                        drop(a);
+                        drop(b);
+                    }
+                })
+            })
+            .collect();
+        for handle in handles {
+            handle.join().unwrap();
+        }
+        assert_eq!(entries(), 0);
+    }
+}
